 /// Sending half of a [`StreamLink`].
 pub struct StreamLinkTx {
-    tx: mpsc::Sender<QueuedFrame>,
+    tx: mpsc::Sender<QueuedWrite>,
     writer_task: JoinHandle<io::Result<()>>,
+    admission: vox_rt::sync::Mutex<bool>,
+    close_claimed: AtomicBool,
